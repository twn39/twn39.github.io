---
// src/components/dai/DaiBlueprintGrid.astro
interface Props {
  title: string;
  handNote?: string;
  specCode?: string;
  columns?: '1' | '2' | '3' | '4';
  showHatchBottom?: boolean;
  id?: string;
}

const {
  title = 'Overview',
  handNote = '',
  specCode = '',
  columns = '2',
  showHatchBottom = true,
  id,
} = Astro.props;

const gridLayout = {
  '1': 'grid-cols-1 blueprint-grid-1',
  '2': 'grid-cols-1 md:grid-cols-2 blueprint-grid-2',
  '3': 'grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-edge',
  '4': 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-edge',
}[columns];
---

<section id={id} class="screen-line-bottom bg-white dark:bg-zinc-950">
  <header class="px-5 sm:px-6 py-3.5 border-b border-edge flex items-center justify-between gap-4 bg-white dark:bg-zinc-950">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="w-1.5 h-1.5 rounded-full bg-espresso-500 shrink-0" />
      <h2 class="font-mono text-[11px] font-semibold uppercase tracking-widest text-zinc-700 dark:text-zinc-300 truncate">
        {title}
      </h2>
      {specCode && (
        <span class="hidden sm:inline-flex items-center font-mono text-[10px] px-1.5 py-0.5 rounded-md border border-edge text-zinc-400 bg-zinc-50/70 dark:bg-zinc-900/50 leading-none">
          {specCode}
        </span>
      )}
    </div>
    <div class="flex items-center gap-3.5 shrink-0">
      {handNote && <span class="font-hand text-base text-zinc-400 dark:text-zinc-500">{handNote}</span>}
      <slot name="action" />
    </div>
  </header>

  <div class:list={['grid', gridLayout]}>
    <slot />
  </div>
</section>

{showHatchBottom && (
  <div
    class="h-3.5 bg-zinc-50/60 dark:bg-zinc-900/25 bg-hatch screen-line-bottom"
    aria-hidden="true"
  />
)}
