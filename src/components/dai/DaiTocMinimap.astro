---
// src/components/dai/DaiTocMinimap.astro
import { useTranslations, type Lang } from '../../i18n/ui';

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: TocHeading[];
  lang?: Lang;
  mode?: 'desktop' | 'mobile';
}

const {
  headings = [],
  lang = 'zh',
  mode = 'desktop',
} = Astro.props;

const t = useTranslations(lang);
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && mode === 'desktop' && (
  <aside
    data-toc-minimap
    aria-label={t('blog.toc')}
    class="flex flex-col gap-4 min-h-0 font-sans"
  >
    <!-- Header & Live Scroll Progress -->
    <div class="shrink-0 flex items-center justify-between border-b border-edge pb-2.5">
      <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
        {t('blog.toc')}
      </span>
      <span
        data-toc-progress
        class="font-mono text-[10px] px-1.5 py-0.5 rounded border border-edge text-espresso-600 dark:text-espresso-400"
      >
        0%
      </span>
    </div>

    <!-- ChanhDai Signature Proportional Minimap Scale Bars -->
    <div
      class="shrink-0 p-3 rounded-lg border border-edge bg-zinc-50/70 dark:bg-zinc-900/40 space-y-1.5"
      aria-hidden="true"
    >
      <div class="flex items-center justify-between font-mono text-[9px] uppercase tracking-wider text-zinc-400 mb-2">
        <span>{t('blog.toc.minimap')}</span>
        <span>{filtered.length} SEC</span>
      </div>
      <div class="flex flex-col gap-1.5">
        {filtered.map((h, i) => {
          const widthPct = h.depth === 2 ? Math.min(92, Math.max(58, h.text.length * 3.2)) : Math.min(68, Math.max(36, h.text.length * 2.4));
          return (
            <a
              href={`#${h.slug}`}
              data-toc-bar={h.slug}
              title={h.text}
              class="group/bar flex items-center py-0.5"
            >
              <span
                style={`width: ${widthPct}%`}
                class:list={[
                  'block h-[2.5px] rounded-full transition-all duration-200',
                  h.depth === 3 ? 'ml-3' : '',
                  i === 0 ? 'bg-espresso-500' : 'bg-zinc-300 dark:bg-zinc-700 group-hover/bar:bg-zinc-500',
                ]}
              />
            </a>
          );
        })}
      </div>
    </div>

    <!-- Full Textual Section Links -->
    <nav class="space-y-1 text-xs min-h-24 flex-1 max-h-[52vh] lg:max-h-none overflow-y-auto pr-1">
      {filtered.map((h, idx) => (
        <a
          href={`#${h.slug}`}
          data-toc-link={h.slug}
          class:list={[
            'block py-1.5 border-l-2 transition-colors leading-snug',
            h.depth === 3 ? 'pl-5 text-[11.5px]' : 'pl-3 font-medium',
            idx === 0
              ? 'border-espresso-500 text-zinc-950 dark:text-zinc-50'
              : 'border-transparent text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 hover:border-zinc-300 dark:hover:border-zinc-700',
          ]}
        >
          {h.text}
        </a>
      ))}
    </nav>
  </aside>
)}

{filtered.length > 0 && mode === 'mobile' && (
  <details class="lg:hidden mb-6 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/40 overflow-hidden group">
    <summary class="px-4 py-2.5 cursor-pointer list-none flex items-center justify-between font-mono text-xs font-medium text-zinc-700 dark:text-zinc-200">
      <span class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-espresso-500" />
        {t('blog.toc')} ({filtered.length})
      </span>
      <span class="text-zinc-400 transition-transform group-open:rotate-180">▾</span>
    </summary>
    <nav class="px-4 pb-3 pt-1 border-t border-zinc-200/80 dark:border-zinc-800/80 space-y-1.5 text-xs">
      {filtered.map((h) => (
        <a
          href={`#${h.slug}`}
          class:list={[
            'block py-1 text-zinc-600 dark:text-zinc-300 hover:text-espresso-500',
            h.depth === 3 ? 'pl-4 text-[11px] text-zinc-500' : 'font-medium',
          ]}
        >
          {h.text}
        </a>
      ))}
    </nav>
  </details>
)}

<script>
  function initTocScrollspy() {
    const aside = document.querySelector<HTMLElement>('[data-toc-minimap]');
    if (!aside || aside.dataset.bound === 'true') return;
    aside.dataset.bound = 'true';

    const links = Array.from(aside.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const bars = Array.from(aside.querySelectorAll<HTMLAnchorElement>('[data-toc-bar]'));
    const progressEl = aside.querySelector<HTMLElement>('[data-toc-progress]');
    const slugs = links.map((l) => l.dataset.tocLink || '').filter(Boolean);
    const headingEls = slugs
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    function setActive(activeSlug: string) {
      links.forEach((link) => {
        const isActive = link.dataset.tocLink === activeSlug;
        link.classList.toggle('border-espresso-500', isActive);
        link.classList.toggle('text-zinc-950', isActive);
        link.classList.toggle('dark:text-zinc-50', isActive);
        link.classList.toggle('border-transparent', !isActive);
        link.classList.toggle('text-zinc-500', !isActive);
        link.classList.toggle('dark:text-zinc-400', !isActive);
      });

      bars.forEach((bar) => {
        const span = bar.querySelector('span');
        if (!span) return;
        const isActive = bar.dataset.tocBar === activeSlug;
        span.classList.toggle('bg-espresso-500', isActive);
        span.classList.toggle('h-[3.5px]', isActive);
        span.classList.toggle('bg-zinc-300', !isActive);
        span.classList.toggle('dark:bg-zinc-700', !isActive);
      });
    }

    function onScroll() {
      const article = document.querySelector<HTMLElement>('[data-article-body]');
      if (article && progressEl) {
        const rect = article.getBoundingClientRect();
        const total = Math.max(1, article.offsetHeight - window.innerHeight * 0.55);
        const passed = Math.min(total, Math.max(0, -rect.top + 120));
        const pct = Math.round((passed / total) * 100);
        progressEl.textContent = `${pct}%`;
      }

      let current = slugs[0] || '';
      for (const el of headingEls) {
        if (el.getBoundingClientRect().top <= 130) {
          current = el.id;
        } else {
          break;
        }
      }
      if (current) setActive(current);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  initTocScrollspy();
  document.addEventListener('astro:page-load', initTocScrollspy);
</script>
