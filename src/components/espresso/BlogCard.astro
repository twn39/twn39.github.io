---
import { resolveProjectMeta } from '../../data/projects';
import { formatDate, localizePath, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  readingTime: number;
  projectSlug: string;
  tags: string[];
  coverImage: string;
  coverAlt: string;
  lang: Lang;
}

const {
  slug,
  title,
  description,
  pubDate,
  readingTime,
  projectSlug,
  tags,
  coverImage,
  coverAlt,
  lang,
} = Astro.props;

const t = useTranslations(lang);
const project = resolveProjectMeta(projectSlug, lang);
const postHref = localizePath(`/blog/${slug}/`, lang);
const rawMdHref = localizePath(`/blog/${slug}.md`, lang);
---

<article
  data-blog-card
  data-project={projectSlug}
  class="group p-5 sm:p-6 bg-white dark:bg-zinc-950 hover:bg-zinc-50/60 dark:hover:bg-zinc-900/30 transition-colors flex flex-col sm:flex-row gap-5 items-stretch"
>
  <!-- Left/Right Content -->
  <div class="flex-1 min-w-0 flex flex-col justify-between">
    <div>
      <!-- Meta Header -->
      <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] text-zinc-400">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
        <span>·</span>
        <span>{readingTime} {t('blog.read_time')}</span>
        {project && (
          <>
            <span>·</span>
            <a
              href={project.href}
              class="inline-flex items-center gap-1 px-2 py-0.5 rounded border border-espresso-500/30 bg-espresso-50/60 dark:bg-espresso-900/15 text-espresso-700 dark:text-espresso-300 hover:border-espresso-500 transition-colors"
            >
              <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${project.primaryLangColor};`} />
              {project.name}
            </a>
          </>
        )}
      </div>

      <!-- Title -->
      <h3 class="mt-2 text-base sm:text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50 group-hover:text-espresso-600 dark:group-hover:text-espresso-400 transition-colors leading-snug">
        <a href={postHref}>{title}</a>
      </h3>

      <!-- Summary -->
      <p class="mt-2 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed line-clamp-2">
        {description}
      </p>
    </div>

    <!-- Tags + Raw .md AI Endpoint -->
    <div class="mt-4 flex flex-wrap items-center justify-between gap-2 pt-2">
      <div class="flex flex-wrap items-center gap-1.5">
        {tags.map((tag) => (
          <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-edge">
            #{tag}
          </span>
        ))}
      </div>
      <a
        href={rawMdHref}
        title="LLM-ready clean Markdown endpoint"
        class="font-mono text-[10px] text-zinc-400 hover:text-espresso-500 transition-colors"
      >
        .md ↗
      </a>
    </div>
  </div>

  <!-- Illustrated Diagram Thumbnail -->
  <a
    href={postHref}
    class="sm:w-52 md:w-60 shrink-0 rounded-lg border border-edge overflow-hidden bg-zinc-950 flex items-center justify-center group-hover:border-espresso-500/50 transition-colors"
  >
    <img
      src={coverImage}
      alt={coverAlt}
      loading="lazy"
      class="w-full h-32 sm:h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
  </a>
</article>
