---
import '../styles/chanhdai-blueprint.css';
import SearchModal from '../components/espresso/SearchModal.astro';
import BrandLogo from '../components/espresso/BrandLogo.astro';
import {
  getLangFromUrl,
  localizePath,
  switchLocalePath,
  useTranslations,
  type Lang,
} from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  alternatePath?: string;
  rawMarkdownUrl?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  maxWidth?: '3xl' | '5xl' | '7xl';
}

const detectedLang = getLangFromUrl(Astro.url);
const {
  lang = detectedLang,
  title,
  description,
  alternatePath,
  rawMarkdownUrl,
  ogType = 'website',
  jsonLd,
  maxWidth = '5xl',
} = Astro.props;

const t = useTranslations(lang);
const pageTitle = title ? `${title} — ${t('site.name')}` : `${t('site.name')} · ${t('site.subtitle')}`;
const pageDescription = description || t('site.description');

const maxWClass = {
  '3xl': 'max-w-3xl',
  '5xl': 'max-w-5xl',
  '7xl': 'max-w-7xl',
}[maxWidth];

const currentPath = Astro.url.pathname;
const zhHref = alternatePath && lang === 'en' ? alternatePath : switchLocalePath(currentPath, 'zh');
const enHref = alternatePath && lang === 'zh' ? alternatePath : switchLocalePath(currentPath, 'en');

const siteOrigin = Astro.site?.origin || 'https://twn39.github.io';
const canonicalUrl = new URL(currentPath, siteOrigin).toString();
const zhFullUrl = new URL(zhHref, siteOrigin).toString();
const enFullUrl = new URL(enHref, siteOrigin).toString();

const navLinks = [
  { key: 'overview', label: t('nav.overview'), href: localizePath('/', lang) },
  { key: 'projects', label: t('nav.projects'), href: localizePath('/projects/', lang) },
  { key: 'closed_projects', label: t('nav.closed_projects'), href: localizePath('/closed-source/', lang) },
  { key: 'blog', label: t('nav.blog'), href: localizePath('/blog/', lang) },
];

function isNavActive(href: string, pathname: string): boolean {
  const cleanHref = href.replace(/\/$/, '') || '/';
  const cleanPath = pathname.replace(/\/$/, '') || '/';
  if (cleanHref === '/' || cleanHref === '/en') {
    return cleanPath === cleanHref;
  }
  return cleanPath.startsWith(cleanHref);
}
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Bilingual hreflang SEO -->
    <link rel="alternate" hreflang="zh-CN" href={zhFullUrl} />
    <link rel="alternate" hreflang="en" href={enFullUrl} />
    <link rel="alternate" hreflang="x-default" href={zhFullUrl} />

    <!-- AI Agent & LLM Search Indexing Discovery -->
    <link rel="alternate" type="text/plain" title="LLMs.txt" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="LLMs Full Corpus" href="/llms-full.txt" />
    <link rel="alternate" type="application/rss+xml" title="BitesBytes Lab RSS" href="/rss.xml" />
    {rawMarkdownUrl && (
      <link rel="alternate" type="text/markdown" title="Clean Markdown for AI" href={rawMarkdownUrl} />
    )}

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="BitesBytes Lab" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Zero-FOUC Theme Initialization -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('espresso-theme');
        if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>

  <body class="bg-white dark:bg-[#090d16] text-slate-900 dark:text-slate-50 antialiased selection:bg-espresso-500 selection:text-white">
    <!-- Sticky Minimalist Blueprint Header -->
    <header class="sticky top-0 z-40 backdrop-blur-md bg-white/90 dark:bg-[#090d16]/90 border-b border-edge">
      <div class:list={[maxWClass, 'mx-auto px-4 sm:px-6 h-15 flex items-center justify-between gap-4 border-x border-edge']}>
        <!-- Left: Brand Identity -->
        <a
          href={localizePath('/', lang)}
          aria-label={`${t('site.name')} — ${t('site.subtitle')}`}
          class="flex items-center gap-2.5 group shrink-0"
        >
          <BrandLogo size="md" />
          <span class="hidden lg:inline-block h-3.5 w-px bg-zinc-200 dark:bg-zinc-800" aria-hidden="true" />
          <span class="hidden lg:inline text-xs text-zinc-500 dark:text-zinc-400">
            {t('site.subtitle')}
          </span>
        </a>

        <!-- Center: Clean Pill Navigation -->
        <nav
          aria-label="Primary"
          class="flex items-center gap-1 p-1 rounded-xl border border-edge bg-zinc-100/70 dark:bg-zinc-900/70"
        >
          {navLinks.map((item) => {
            const active = isNavActive(item.href, currentPath);
            return (
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'px-3 sm:px-3.5 py-1 rounded-lg text-xs sm:text-[13px] transition-all whitespace-nowrap',
                  active
                    ? 'bg-white dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold shadow-2xs ring-1 ring-zinc-950/5 dark:ring-white/10'
                    : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- Right Controls: Search ⌘K + Language Switcher + GitHub + Theme (Unified 32px h-8 grid) -->
        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            data-open-search
            class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-lg border border-edge bg-zinc-50/70 dark:bg-zinc-900/60 text-xs text-zinc-500 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors cursor-pointer"
            aria-label={t('nav.search')}
          >
            <svg class="w-3.5 h-3.5 shrink-0 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <span class="hidden sm:inline text-[11.5px]">{t('nav.search')}</span>
            <kbd class="hidden sm:inline font-mono text-[10px] px-1 py-0.5 rounded bg-white dark:bg-zinc-800 border border-edge text-zinc-400 leading-none">
              ⌘K
            </kbd>
          </button>

          <!-- Bilingual Segmented Control (Balanced pill geometry, subtle elevation) -->
          <div
            role="group"
            aria-label="Language switcher"
            class="inline-grid grid-cols-2 items-center h-8 p-0.5 rounded-lg border border-edge bg-zinc-100/85 dark:bg-zinc-900/85 font-mono text-[11px]"
          >
            <a
              href={zhHref}
              aria-current={lang === 'zh' ? 'true' : undefined}
              class:list={[
                'h-full min-w-[30px] px-2 inline-flex items-center justify-center rounded-[6px] transition-all leading-none',
                lang === 'zh'
                  ? 'bg-white text-zinc-950 font-semibold shadow-2xs ring-1 ring-zinc-950/5 dark:bg-zinc-800 dark:text-zinc-50 dark:ring-white/10'
                  : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200',
              ]}
            >
              中
            </a>
            <a
              href={enHref}
              aria-current={lang === 'en' ? 'true' : undefined}
              class:list={[
                'h-full min-w-[30px] px-2 inline-flex items-center justify-center rounded-[6px] transition-all leading-none',
                lang === 'en'
                  ? 'bg-white text-zinc-950 font-semibold shadow-2xs ring-1 ring-zinc-950/5 dark:bg-zinc-800 dark:text-zinc-50 dark:ring-white/10'
                  : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200',
              ]}
            >
              EN
            </a>
          </div>

          <!-- GitHub Link -->
          <a
            href="https://github.com/twn39"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub (@twn39)"
            class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-edge bg-white dark:bg-zinc-950 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100/80 dark:hover:bg-zinc-900 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
            </svg>
          </a>

          <!-- Theme Toggle (Crisp Vector Sun & Moon SVGs) -->
          <button
            id="theme-toggle"
            type="button"
            aria-label={t('nav.theme')}
            title={t('nav.theme')}
            class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-edge bg-white dark:bg-zinc-950 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100/80 dark:hover:bg-zinc-900 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors cursor-pointer group"
          >
            <!-- Moon Icon (shown in Light Mode) -->
            <svg
              class="w-4 h-4 dark:hidden transition-transform duration-200 group-hover:-rotate-12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
            <!-- Sun Icon (shown in Dark Mode) -->
            <svg
              class="w-4 h-4 hidden dark:block transition-transform duration-200 group-hover:rotate-45"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2" />
              <path d="M12 20v2" />
              <path d="m4.93 4.93 1.41 1.41" />
              <path d="m17.66 17.66 1.41 1.41" />
              <path d="M2 12h2" />
              <path d="M20 12h2" />
              <path d="m6.34 17.66-1.41 1.41" />
              <path d="m19.07 4.93-1.41 1.41" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Blueprint Rail Container -->
    <main class:list={[maxWClass, 'mx-auto border-x border-edge min-h-[calc(100vh-3.75rem)] flex flex-col']}>
      <div>
        <slot />
      </div>
      <div class="flex-1" />

      <!-- Minimalist Site Footer -->
      <footer class="mt-[-1px] screen-line-top bg-slate-50/50 dark:bg-[#090d16] px-6 py-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-zinc-500 dark:text-zinc-400">
          <!-- Brand & Copyright -->
          <div class="flex flex-wrap items-center gap-2">
            <a href={localizePath('/', lang)} class="group inline-flex items-center">
              <BrandLogo size="sm" />
            </a>
            <span class="text-zinc-300 dark:text-zinc-700">·</span>
            <span>{t('site.subtitle')}</span>
            <span class="text-zinc-300 dark:text-zinc-700">·</span>
            <span>© {new Date().getFullYear()} {t('footer.rights')}</span>
          </div>

          <!-- Related Links (GitHub, Navigation, llms.txt, RSS) -->
          <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[11.5px]">
            <a
              href="https://github.com/twn39"
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors"
            >
              github.com/twn39
            </a>
            <a
              href={localizePath('/projects/', lang)}
              class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors font-sans text-xs"
            >
              {t('nav.projects')}
            </a>
            <a
              href={localizePath('/closed-source/', lang)}
              class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors font-sans text-xs"
            >
              {t('nav.closed_projects')}
            </a>
            <a
              href={localizePath('/blog/', lang)}
              class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors font-sans text-xs"
            >
              {t('nav.blog')}
            </a>
            <a
              href="/llms.txt"
              class="text-zinc-600 dark:text-zinc-400 hover:text-espresso-600 dark:hover:text-espresso-400 transition-colors"
            >
              llms.txt
            </a>
            <a
              href="/llms-full.txt"
              class="text-zinc-600 dark:text-zinc-400 hover:text-espresso-600 dark:hover:text-espresso-400 transition-colors"
            >
              llms-full.txt
            </a>
            <a
              href="/rss.xml"
              class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors"
            >
              RSS
            </a>
          </nav>
        </div>
      </footer>
    </main>

    <!-- Global Search Command Palette -->
    <SearchModal lang={lang} />

    <script>
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        if (!btn || btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('espresso-theme', isDark ? 'dark' : 'light');
        });
      }
      initThemeToggle();
      document.addEventListener('astro:page-load', initThemeToggle);
    </script>
  </body>
</html>
