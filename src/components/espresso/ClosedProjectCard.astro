---
import DaiGlowCardGrid from '../dai/DaiGlowCardGrid.astro';
import type { EspressoClosedProject } from '../../data/projects';
import { localizePath, useTranslations, type Lang } from '../../i18n/ui';

interface LinkedPost {
  slug: string;
  title: string;
  readingTime: number;
}

interface Props {
  project: EspressoClosedProject;
  lang: Lang;
  relatedPosts?: LinkedPost[];
  compact?: boolean;
}

const {
  project,
  lang,
  relatedPosts = [],
  compact = false,
} = Astro.props;

const t = useTranslations(lang);
const info = project.i18n[lang];
const storeHref = project.appStoreUrl[lang];
---

<DaiGlowCardGrid class="p-6 flex flex-col justify-between h-full">
  <div>
    <!-- Top Row: Real App Icon + Title + Platform Pill -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3.5 min-w-0">
        <a
          href={storeHref}
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 rounded-[13px] border border-edge overflow-hidden shrink-0 shadow-2xs hover:opacity-90 transition-opacity bg-zinc-100 dark:bg-zinc-900"
        >
          <img
            src={project.iconPath}
            alt={info.displayName}
            width="48"
            height="48"
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </a>
        <div class="min-w-0">
          <div class="font-mono text-[10.5px] text-zinc-400 truncate">
            {info.category}
          </div>
          <h3 class="mt-0.5 text-base sm:text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50 flex flex-wrap items-center gap-2">
            <a
              href={storeHref}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-espresso-600 dark:hover:text-espresso-400 transition-colors truncate"
            >
              {info.displayName}
            </a>
            <span class="font-mono text-[10px] font-normal px-1.5 py-0.5 rounded border border-edge text-zinc-500 shrink-0">
              {project.version}
            </span>
          </h3>
        </div>
      </div>

      <span class="hidden sm:inline-flex items-center gap-1.5 font-mono text-[10px] px-2.5 py-0.5 rounded-full border border-edge bg-zinc-50 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 shrink-0">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" />
        {project.deliveryModel}
      </span>
    </div>

    <!-- Tagline & Summary -->
    <p class="mt-3.5 text-sm font-medium text-zinc-800 dark:text-zinc-200 leading-snug">
      {info.tagline}
    </p>
    <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
      {info.summary}
    </p>

    {!compact && (
      <ul class="mt-4 space-y-1.5 border-t border-edge pt-3">
        {info.highlights.map((hl) => (
          <li class="flex items-start gap-2 text-xs text-zinc-600 dark:text-zinc-300">
            <span class="font-mono text-espresso-500 mt-0.5">›</span>
            <span>{hl}</span>
          </li>
        ))}
      </ul>
    )}

    <!-- Core Implementation Stack Breakdown -->
    <div class="mt-4">
      <div class="h-1.5 w-full rounded-full overflow-hidden flex bg-zinc-100 dark:bg-zinc-900">
        {project.languages.map((l) => (
          <span style={`width: ${l.percent}%; background-color: ${l.color};`} title={`${l.name} ${l.percent}%`} />
        ))}
      </div>
      <div class="mt-2 flex flex-wrap items-center gap-3 font-mono text-[10px] text-zinc-500 dark:text-zinc-400">
        {project.languages.map((l) => (
          <span class="inline-flex items-center gap-1">
            <span class="w-2 h-2 rounded-full" style={`background-color: ${l.color};`} />
            {l.name} <span class="opacity-65">{l.percent}%</span>
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Linked Public Architecture Essays + Quick App Store Link -->
  <div class="mt-5 pt-4 border-t border-edge space-y-2.5">
    <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-wider text-zinc-400">
      <span>{t('closed.related_posts')} ({relatedPosts.length})</span>
      <a
        href={storeHref}
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-700 dark:text-zinc-200 hover:text-espresso-500 inline-flex items-center gap-1 normal-case font-medium"
      >
        App Store ↗
      </a>
    </div>

    {relatedPosts.length > 0 ? (
      <div class="space-y-1.5">
        {relatedPosts.map((post) => (
          <a
            href={localizePath(`/blog/${post.slug}/`, lang)}
            class="group/post flex items-center justify-between gap-2 px-2.5 py-2 rounded-md border border-edge bg-zinc-50/70 dark:bg-zinc-900/40 hover:border-espresso-500/50 transition-colors"
          >
            <span class="text-xs font-medium text-zinc-800 dark:text-zinc-200 group-hover/post:text-espresso-600 dark:group-hover/post:text-espresso-400 truncate">
              ✦ {post.title}
            </span>
            <span class="font-mono text-[10px] text-zinc-400 shrink-0">
              {post.readingTime}m →
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="font-mono text-[11px] text-zinc-400">{t('closed.no_posts')}</p>
    )}
  </div>
</DaiGlowCardGrid>
