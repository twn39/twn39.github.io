---
// src/components/dai/DaiButton.astro
interface Props {
  variant?: 'primary' | 'outline' | 'ghost' | 'hatch';
  size?: 'sm' | 'md' | 'lg';
  statusDot?: boolean;
  dimensionTag?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  statusDot = true,
  dimensionTag = '32px',
  class: className = '',
} = Astro.props;

const variantClasses = {
  primary: 'bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 border-zinc-900 dark:border-white hover:opacity-90',
  outline: 'bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 border-zinc-300 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-900',
  ghost: 'bg-transparent text-zinc-700 dark:text-zinc-300 border-transparent hover:bg-zinc-100 dark:hover:bg-zinc-900',
  hatch: 'bg-hatch text-zinc-900 dark:text-zinc-100 border-zinc-300 dark:border-zinc-700',
}[variant];

const sizeClasses = {
  sm: 'h-7 px-2.5 text-xs',
  md: 'h-9 px-3.5 text-xs',
  lg: 'h-11 px-5 text-sm',
}[size];
---

<button
  data-dai-button
  class:list={[
    'inline-flex items-center gap-2 rounded-md border font-medium transition-all active:scale-[0.98]',
    variantClasses,
    sizeClasses,
    className,
  ]}
>
  {statusDot && <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />}
  <slot>Deploy Registry</slot>
  {dimensionTag && (
    <span class="font-mono text-[10px] opacity-60 px-1 rounded border border-current/20">
      {dimensionTag}
    </span>
  )}
</button>