---
// src/components/dai/DaiLightbox.astro
import { resolvePublicImageMeta } from '../../lib/image-meta.mjs';

interface Props {
  src?: string;
  alt?: string;
  exifSpec?: string;
  enableGlobalModal?: boolean;
}

const {
  src,
  alt = '',
  exifSpec = 'BLUEPRINT VECTOR · 1:1 INSPECT',
  enableGlobalModal = false,
} = Astro.props;

const imgMeta = src ? resolvePublicImageMeta(src) : {};
---

{src ? (
  <figure
    data-dai-lightbox
    class="group/fig rounded-xl border border-edge bg-zinc-50/80 dark:bg-zinc-950/90 p-2 sm:p-2.5 overflow-hidden transition-colors hover:border-espresso-500/45"
  >
    <div class="relative overflow-hidden rounded-lg border border-edge bg-white dark:bg-zinc-900">
      <picture class="block">
        {imgMeta.webpSrc && <source srcset={imgMeta.webpSrc} type="image/webp" />}
        <img
          src={src}
          alt={alt}
          width={imgMeta.width}
          height={imgMeta.height}
          decoding="async"
          data-lightbox-src={src}
          data-lightbox-spec={exifSpec}
          class="w-full h-auto block cursor-zoom-in transition-transform duration-300 ease-out group-hover/fig:scale-[1.008]"
          loading="eager"
        />
      </picture>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute right-2.5 bottom-2.5 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-zinc-950/75 text-zinc-100 backdrop-blur-md border border-white/15 font-mono text-[10px] opacity-0 translate-y-1 group-hover/fig:opacity-100 group-hover/fig:translate-y-0 transition-all duration-200 shadow-sm"
      >
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" />
          <path d="M11 8v6M8 11h6" />
        </svg>
        Inspect
      </span>
    </div>
    <figcaption class="px-1.5 pt-2.5 pb-0.5 flex items-center justify-between gap-3 font-mono text-[10.5px] text-zinc-500 dark:text-zinc-400">
      <span class="truncate">{alt}</span>
      <span class="text-espresso-600 dark:text-espresso-400 shrink-0">{exifSpec}</span>
    </figcaption>
  </figure>
) : (
  !enableGlobalModal && (
    <figure data-dai-lightbox class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-950 p-3">
      <slot />
      <figcaption class="font-mono text-[10px] text-zinc-400 mt-2">{exifSpec}</figcaption>
    </figure>
  )
)}

{enableGlobalModal && (
  <div
    id="espresso-lightbox-modal"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    class="fixed inset-0 z-50 hidden flex-col justify-between bg-[#070a12]/92 backdrop-blur-2xl select-none opacity-0 transition-opacity duration-200 ease-out"
  >
    <!-- Top Floating Glass HUD -->
    <header class="relative z-20 flex items-center justify-between gap-3 px-4 sm:px-6 py-3.5 border-b border-white/[0.08] bg-zinc-950/55 backdrop-blur-md">
      <div class="flex items-center gap-3 min-w-0">
        <span
          id="espresso-lightbox-counter"
          class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-md bg-white/[0.07] border border-white/10 font-mono text-[11px] text-zinc-200 tabular-nums shrink-0"
        >
          01 / 01
        </span>
        <span
          id="espresso-lightbox-spec"
          class="font-mono text-[11px] text-espresso-400 truncate"
        >
          FIG · BLUEPRINT INSPECTOR
        </span>
        <span
          id="espresso-lightbox-dims"
          class="hidden md:inline-flex font-mono text-[10.5px] text-zinc-400 shrink-0 tabular-nums"
        />
      </div>

      <!-- Zoom & Action Toolbar -->
      <div class="flex items-center gap-1.5 shrink-0">
        <div class="hidden sm:inline-flex items-center p-0.5 rounded-lg border border-white/10 bg-white/[0.05] font-mono text-[11px] text-zinc-300">
          <button
            type="button"
            id="espresso-lightbox-zoom-out"
            title="Zoom out (-)"
            aria-label="Zoom out"
            class="w-7 h-7 inline-flex items-center justify-center rounded-md hover:bg-white/10 hover:text-white transition-colors cursor-pointer"
          >
            −
          </button>
          <button
            type="button"
            id="espresso-lightbox-zoom-reset"
            title="Reset zoom (0)"
            class="min-w-[46px] h-7 px-2 inline-flex items-center justify-center rounded-md hover:bg-white/10 hover:text-white transition-colors cursor-pointer tabular-nums"
          >
            Fit
          </button>
          <button
            type="button"
            id="espresso-lightbox-zoom-in"
            title="Zoom in (+)"
            aria-label="Zoom in"
            class="w-7 h-7 inline-flex items-center justify-center rounded-md hover:bg-white/10 hover:text-white transition-colors cursor-pointer"
          >
            +
          </button>
        </div>

        <a
          id="espresso-lightbox-raw"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          title="Open original image"
          aria-label="Open original image"
          class="w-8 h-8 inline-flex items-center justify-center rounded-lg border border-white/10 bg-white/[0.05] text-zinc-300 hover:bg-white/12 hover:text-white transition-colors"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
        </a>

        <button
          type="button"
          id="espresso-lightbox-close"
          title="Close (ESC)"
          aria-label="Close lightbox"
          class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg border border-white/12 bg-white/[0.07] text-zinc-100 hover:bg-white/15 font-mono text-[11px] transition-colors cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
          <span class="hidden sm:inline">ESC</span>
        </button>
      </div>
    </header>

    <!-- Center Stage -->
    <div
      id="espresso-lightbox-stage"
      class="relative flex-1 min-h-0 flex items-center justify-center overflow-hidden px-4 sm:px-16 py-4"
    >
      <!-- Prev Button -->
      <button
        type="button"
        id="espresso-lightbox-prev"
        aria-label="Previous image"
        class="hidden absolute left-3 sm:left-5 z-20 w-10 h-10 rounded-full border border-white/12 bg-zinc-950/70 backdrop-blur-md text-zinc-200 hover:text-white hover:bg-zinc-900 hover:border-white/25 items-center justify-center transition-all cursor-pointer shadow-lg"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>

      <!-- Image Frame -->
      <div
        id="espresso-lightbox-viewport"
        class="relative max-w-full max-h-full flex items-center justify-center transition-transform duration-200 ease-out origin-center"
      >
        <img
          id="espresso-lightbox-img"
          src=""
          alt=""
          draggable="false"
          class="max-w-[92vw] sm:max-w-[84vw] max-h-[68vh] sm:max-h-[72vh] w-auto h-auto object-contain rounded-xl ring-1 ring-white/15 shadow-[0_28px_90px_-18px_rgba(0,0,0,0.85)] bg-white cursor-zoom-in transition-[opacity,transform] duration-200 ease-out"
        />
      </div>

      <!-- Next Button -->
      <button
        type="button"
        id="espresso-lightbox-next"
        aria-label="Next image"
        class="hidden absolute right-3 sm:right-5 z-20 w-10 h-10 rounded-full border border-white/12 bg-zinc-950/70 backdrop-blur-md text-zinc-200 hover:text-white hover:bg-zinc-900 hover:border-white/25 items-center justify-center transition-all cursor-pointer shadow-lg"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>
    </div>

    <!-- Bottom Caption & Filmstrip Dock -->
    <footer class="relative z-20 px-4 sm:px-6 pb-4 pt-2.5 border-t border-white/[0.08] bg-zinc-950/60 backdrop-blur-md flex flex-col items-center gap-2.5">
      <p
        id="espresso-lightbox-caption"
        class="text-xs sm:text-[13px] text-zinc-200 text-center max-w-3xl leading-relaxed line-clamp-2"
      />
      <div
        id="espresso-lightbox-thumbs"
        class="hidden items-center gap-2 overflow-x-auto max-w-full py-0.5 px-1"
      />
    </footer>
  </div>
)}

{enableGlobalModal && (
  <script>
    interface LightboxItem {
      src: string;
      alt: string;
      spec: string;
    }

    function initBlueprintLightbox() {
      const modal = document.getElementById('espresso-lightbox-modal');
      const stage = document.getElementById('espresso-lightbox-stage');
      const viewport = document.getElementById('espresso-lightbox-viewport');
      const modalImg = document.getElementById('espresso-lightbox-img') as HTMLImageElement | null;
      const modalCaption = document.getElementById('espresso-lightbox-caption');
      const modalSpec = document.getElementById('espresso-lightbox-spec');
      const modalDims = document.getElementById('espresso-lightbox-dims');
      const modalCounter = document.getElementById('espresso-lightbox-counter');
      const rawLink = document.getElementById('espresso-lightbox-raw') as HTMLAnchorElement | null;
      const thumbsWrap = document.getElementById('espresso-lightbox-thumbs');
      const prevBtn = document.getElementById('espresso-lightbox-prev');
      const nextBtn = document.getElementById('espresso-lightbox-next');
      const closeBtn = document.getElementById('espresso-lightbox-close');
      const zoomInBtn = document.getElementById('espresso-lightbox-zoom-in');
      const zoomOutBtn = document.getElementById('espresso-lightbox-zoom-out');
      const zoomResetBtn = document.getElementById('espresso-lightbox-zoom-reset');

      if (!modal || !modalImg || !viewport || !stage) return;

      // Collect unique figures across cover + article body in visual order
      const items: LightboxItem[] = [];
      const srcToIndex = new Map<string, number>();

      document.querySelectorAll<HTMLImageElement>('[data-lightbox-src], .espresso-prose img').forEach((img) => {
        const src = img.dataset.lightboxSrc || img.getAttribute('src') || '';
        if (!src) return;

        const figure = img.closest('figure');
        const figcaption = figure?.querySelector('figcaption')?.textContent?.trim();
        const alt = img.getAttribute('alt')?.trim() || figcaption || '';
        const spec = img.dataset.lightboxSpec || '';

        let idx = srcToIndex.get(src);
        if (idx === undefined) {
          idx = items.length;
          srcToIndex.set(src, idx);
          items.push({
            src,
            alt,
            spec: spec || `FIG ${String(idx + 1).padStart(2, '0')} · HIGH-RES DIAGRAM`,
          });
        } else if (spec && !items[idx].spec.includes('·')) {
          items[idx].spec = spec;
        }

        if (img.dataset.lbBound !== 'true') {
          img.dataset.lbBound = 'true';
          img.addEventListener('click', () => {
            const targetIdx = srcToIndex.get(src) ?? 0;
            openAt(targetIdx);
          });
        }
      });

      let currentIndex = 0;
      let scale = 1;
      let panX = 0;
      let panY = 0;
      let isDragging = false;
      let pointerMoved = false;
      let dragStartX = 0;
      let dragStartY = 0;
      let dragOriginX = 0;
      let dragOriginY = 0;
      let touchStartX = 0;

      function applyTransform(animate = true) {
        if (!viewport || !modalImg || !zoomResetBtn) return;
        viewport.style.transition = animate ? 'transform 200ms cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
        viewport.style.transform = `translate3d(${panX}px, ${panY}px, 0) scale(${scale})`;
        zoomResetBtn.textContent = scale === 1 ? 'Fit' : `${Math.round(scale * 100)}%`;

        if (scale > 1) {
          modalImg.classList.remove('cursor-zoom-in');
          modalImg.classList.add(isDragging ? 'cursor-grabbing' : 'cursor-grab');
        } else {
          modalImg.classList.remove('cursor-grab', 'cursor-grabbing');
          modalImg.classList.add('cursor-zoom-in');
        }
      }

      function resetZoom(animate = true) {
        scale = 1;
        panX = 0;
        panY = 0;
        applyTransform(animate);
      }

      function setZoom(nextScale: number) {
        scale = Math.min(3.5, Math.max(1, Number(nextScale.toFixed(2))));
        if (scale === 1) {
          panX = 0;
          panY = 0;
        }
        applyTransform(true);
      }

      function renderThumbs() {
        if (!thumbsWrap) return;
        if (items.length <= 1) {
          thumbsWrap.classList.add('hidden');
          thumbsWrap.classList.remove('flex');
          return;
        }
        thumbsWrap.classList.remove('hidden');
        thumbsWrap.classList.add('flex');
        thumbsWrap.innerHTML = '';

        items.forEach((item, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.ariaLabel = item.alt || `Figure ${i + 1}`;
          const active = i === currentIndex;
          btn.className = active
            ? 'relative w-14 h-9 rounded-md overflow-hidden border-2 border-espresso-400 ring-2 ring-espresso-400/30 bg-white shrink-0 cursor-pointer transition-all'
            : 'relative w-14 h-9 rounded-md overflow-hidden border border-white/15 opacity-55 hover:opacity-95 bg-white shrink-0 cursor-pointer transition-all';
          const thumbImg = document.createElement('img');
          thumbImg.src = item.src;
          thumbImg.alt = '';
          thumbImg.className = 'w-full h-full object-cover';
          btn.appendChild(thumbImg);
          btn.addEventListener('click', () => showSlide(i));
          thumbsWrap.appendChild(btn);
        });
      }

      function showSlide(index: number) {
        if (!modalImg || items.length === 0) return;
        currentIndex = (index + items.length) % items.length;
        const item = items[currentIndex];
        resetZoom(false);

        modalImg.style.opacity = '0.35';
        modalImg.src = item.src;
        modalImg.alt = item.alt;

        if (modalSpec) {
          modalSpec.textContent = item.spec || `FIG ${String(currentIndex + 1).padStart(2, '0')} · BLUEPRINT INSPECTOR`;
        }
        if (modalCaption) {
          modalCaption.textContent = item.alt;
        }
        if (modalCounter) {
          modalCounter.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
        }
        if (rawLink) {
          rawLink.href = item.src;
        }
        if (modalDims) {
          modalDims.textContent = '';
        }

        const showNav = items.length > 1;
        prevBtn?.classList.toggle('hidden', !showNav);
        prevBtn?.classList.toggle('inline-flex', showNav);
        nextBtn?.classList.toggle('hidden', !showNav);
        nextBtn?.classList.toggle('inline-flex', showNav);

        renderThumbs();
      }

      function openAt(index: number) {
        if (!modal) return;
        showSlide(index);
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
        });
      }

      function closeModal() {
        if (!modal || modal.classList.contains('hidden')) return;
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        setTimeout(() => {
          if (modal.getAttribute('aria-hidden') === 'true') {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            resetZoom(false);
          }
        }, 180);
      }

      if (modal.dataset.bound !== 'true') {
        modal.dataset.bound = 'true';

        modalImg.addEventListener('load', () => {
          modalImg.style.opacity = '1';
          if (modalDims && modalImg.naturalWidth > 0) {
            modalDims.textContent = `${modalImg.naturalWidth} × ${modalImg.naturalHeight} px`;
          }
        });

        // Click image to toggle Fit <-> 2x zoom (skip if user dragged to pan)
        modalImg.addEventListener('click', (e) => {
          e.stopPropagation();
          if (pointerMoved) {
            pointerMoved = false;
            return;
          }
          if (scale > 1) {
            resetZoom(true);
          } else {
            setZoom(2);
          }
        });

        modalImg.addEventListener('pointerdown', (e) => {
          pointerMoved = false;
          if (scale <= 1) return;
          isDragging = true;
          dragStartX = e.clientX;
          dragStartY = e.clientY;
          dragOriginX = panX;
          dragOriginY = panY;
          modalImg.setPointerCapture(e.pointerId);
          applyTransform(false);
        });

        modalImg.addEventListener('pointermove', (e) => {
          if (!isDragging) return;
          const dx = e.clientX - dragStartX;
          const dy = e.clientY - dragStartY;
          if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
            pointerMoved = true;
          }
          panX = dragOriginX + dx;
          panY = dragOriginY + dy;
          applyTransform(false);
        });

        const stopDrag = () => {
          if (!isDragging) return;
          isDragging = false;
          applyTransform(false);
        };
        modalImg.addEventListener('pointerup', stopDrag);
        modalImg.addEventListener('pointercancel', stopDrag);

        // Wheel zoom on stage
        stage.addEventListener(
          'wheel',
          (e) => {
            if (modal.classList.contains('hidden')) return;
            e.preventDefault();
            const delta = e.deltaY < 0 ? 0.25 : -0.25;
            setZoom(scale + delta);
          },
          { passive: false }
        );

        // Mobile touch swipe navigation when not zoomed
        stage.addEventListener(
          'touchstart',
          (e) => {
            if (scale === 1 && e.touches.length === 1) {
              touchStartX = e.touches[0].clientX;
            }
          },
          { passive: true }
        );
        stage.addEventListener('touchend', (e) => {
          if (scale !== 1 || e.changedTouches.length !== 1 || items.length <= 1) return;
          const dx = e.changedTouches[0].clientX - touchStartX;
          if (Math.abs(dx) > 48) {
            showSlide(dx > 0 ? currentIndex - 1 : currentIndex + 1);
          }
        });

        prevBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          showSlide(currentIndex - 1);
        });
        nextBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          showSlide(currentIndex + 1);
        });
        zoomInBtn?.addEventListener('click', () => setZoom(scale + 0.5));
        zoomOutBtn?.addEventListener('click', () => setZoom(scale - 0.5));
        zoomResetBtn?.addEventListener('click', () => resetZoom(true));
        closeBtn?.addEventListener('click', closeModal);

        // Click empty backdrop on stage to close
        stage.addEventListener('click', (e) => {
          if (e.target === stage || e.target === viewport) {
            closeModal();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (modal.classList.contains('hidden')) return;
          if (e.key === 'Escape') closeModal();
          else if (e.key === 'ArrowLeft' && items.length > 1) showSlide(currentIndex - 1);
          else if (e.key === 'ArrowRight' && items.length > 1) showSlide(currentIndex + 1);
          else if (e.key === '=' || e.key === '+') setZoom(scale + 0.5);
          else if (e.key === '-') setZoom(scale - 0.5);
          else if (e.key === '0') resetZoom(true);
        });
      }
    }

    initBlueprintLightbox();
    document.addEventListener('astro:page-load', initBlueprintLightbox);
  </script>
)}
