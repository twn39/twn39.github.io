---
// src/components/dai/DaiGlowCardGrid.astro
interface Props {
  glowColor?: string;
  class?: string;
}

const {
  glowColor = 'rgba(205, 119, 69, 0.14)',
  class: className = '',
} = Astro.props;
---

<div
  data-glow-card
  style={`--glow: ${glowColor}; --mouse-x: 50%; --mouse-y: 0%;`}
  class:list={[
    'group relative overflow-hidden bg-white dark:bg-zinc-950 transition-colors',
    className,
  ]}
>
  <div
    class="pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    style="background: radial-gradient(420px circle at var(--mouse-x) var(--mouse-y), var(--glow), transparent 65%);"
    aria-hidden="true"
  />
  <div class="relative z-10 h-full flex flex-col">
    <slot />
  </div>
</div>

<script>
  function initGlowCards() {
    document.querySelectorAll<HTMLElement>('[data-glow-card]').forEach((card) => {
      if (card.dataset.glowBound === 'true') return;
      card.dataset.glowBound = 'true';
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
    });
  }
  initGlowCards();
  document.addEventListener('astro:page-load', initGlowCards);
</script>
